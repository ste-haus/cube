# Required. The token stays here, on the server; panels never receive it.
# Create one under your Home Assistant profile → Security → Long-lived access tokens.
CUBE_HA_URL=http://homeassistant.example.com:8123
CUBE_HA_TOKEN=

# The panel's timezone. The agenda's day boundaries are local, so without this a container
# runs on UTC and 'today' starts at the wrong hour.
TZ=Etc/UTC

# Panel profile served when a request does not name one.
CUBE_PROFILE=default

# Optional. The image sets its own paths and binds on all interfaces, so these matter only
# when running outside a container.
#CUBE_HOST=0.0.0.0
#CUBE_PORT=4096
#CUBE_LOG_LEVEL=info
#CUBE_DASHBOARD_PATH=config.yaml
#CUBE_FRONTEND_PATH=web/dist
#CUBE_RESOURCES_PATH=resources
