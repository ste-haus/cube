# Cube dashboard definition.
#
# Copy to config.yaml and replace the placeholders with your own entities. Nothing in here is
# secret, but it does describe your home, so config.yaml is gitignored.
# The Home Assistant URL and token are supplied by environment instead; see .env.dist.

# Keyed by what the panel asks for: `?profile=<key>`.
#
# `default` is the template every panel starts from rather than a panel itself. It defines all
# six faces and the storey they open on, and names no speaker. A panel is a profile that
# inherits it and states only what makes it different, so a request naming no profile — or one
# that is not defined — gets a generic dashboard rather than one impersonating a room.
#
# `faces` and `floorplan` are inherited. `media_player` never is: a panel following the wrong
# room's speaker looks exactly like one that works, until an announcement lights up the wrong
# wall. Every panel names its own or has none.
profiles:
  default:
    name: Default
    floorplan: downstairs
    faces:
      # The dashboard lays out to the panel's full width, so it names itself and gives the
      # strip back. Every other face carries one unless it says otherwise.
      front:
        content: dashboard
        label_strip: false
      back:
        content: blank
        label: back
      left:
        content: blank
        label: left
      right:
        content: blank
        label: right
      # The conditions, today's range, the sun and moon, and the forecast, all from the
      # `weather` block below. `tiles` is optional, and each goes where its kind belongs: a radar
      # at the top of the left column, cameras and frames in a row beneath it, in the order
      # written. A title captions any of them. A tile is a camera,
      # written as on a camera face; a radar, which centres on `weather.zone_entity_id`; or a
      # frame — another page, drawn edge to edge. A frame takes no touches unless
      # `interactive: true`, so a swipe across it still turns the cube.
      up:
        content: weather
        label: Weather
        options:
          tiles:
            - radar:
                rings: [25, 50, 100]
                ring_unit: mi
            - camera.example_satellite
            - url: https://frames.example/wind.html
              title: Wind
            - camera.example_smoke
      down:
        content: blank
        label: down

  # A panel: everything from `default`, plus the speaker whose announcements it reacts to.
  example:
    name: Example Panel
    media_player: media_player.example_speaker

  # A panel that opens on the other storey and puts a face of its own on the front. `page`
  # names a directory under `faces/` in the resources directory holding an `index.html`.
  example-bedroom:
    name: Example Bedroom
    floorplan: upstairs
    media_player: media_player.example_bedroom_speaker
    faces:
      front:
        content: custom
        page: bedroom

  # `inherits` names the profile to start from instead of `default`, and chains: this one is
  # the bedroom's front face and storey, with a speaker of its own.
  example-office:
    name: Example Office
    inherits: example-bedroom
    media_player: media_player.example_office_speaker

  # The two camera faces. `options` is read by the renderer named in `content`, and a camera is
  # either a bare entity id or the same block the `camera:` section below takes.
  #
  # `camera-grid` is laid out exactly as written: one row per inner list, read left to right.
  # `camera-hero` gives `hero` the face and stacks `side` in a column beside it.
  #
  # A camera is polled for a still every `polling_interval` seconds, sixty unless it says, or
  # plays live video from go2rtc with `stream_type: go2rtc`. Either way it only costs anything
  # while its face is the one being looked at.
  example-cameras:
    name: Example Cameras
    media_player: media_player.example_cameras_speaker
    faces:
      left:
        content: camera-grid
        options:
          rows:
            - [camera.example_front_door, camera.example_driveway]
            - - entity_id: camera.example_back_yard
                title: Back Yard
              - entity_id: camera.example_garage
                polling_interval: 30
      right:
        content: camera-hero
        options:
          # Live: go2rtc plays the RTSP URL itself, so it needs nothing set up for the camera.
          hero:
            entity_id: camera.example_front_door
            stream_type: go2rtc
            rtsp: rtsp://go2rtc.example:8554/example_front_door
          side:
            - camera.example_driveway
            - camera.example_back_yard

# The installation's own colours. Any colour elsewhere in this file may be written as one of these
# names instead of a value, so everything meant to match changes in one place. Every one has a
# default, so the section can be left out, or name only the colours that differ.
#
# `primary` and `secondary` tie the panel together and draw the forecast's highs and lows. The rest
# are the sky's, for the horizon and the daylight bar, and are muted on purpose.
colors:
  primary: "#f205f2"
  secondary: "#00bfff"
  day: "#7a8fa0"
  night: "#2e2a45"
  twilight: "#a0706b"
  sun: "#d0a46c"
  sun_below: "#6d5a50"

# The panel's palette.
theme:
  background: "#111111"

labels:
  notices: Notices
  agenda: Today
  sunrise: Sunrise
  sunset: Sunset
  now: Now

clock:
  date_format: "%A, %B %o, %Y"
  time_format: "%H:%M"
  easter_egg_times: []
  easter_egg_text: ""

# Header read-outs, rendered left to right in the order given.
indicators:
  - icon: mdi:water-outline
    entity_id: sensor.example_precipitation_probability
    precision: 0
    suffix: "%"

  - icon: mdi:weather-windy
    entity_id: weather.example
    attribute: wind_speed
    bearing:
      entity_id: weather.example
      attribute: wind_bearing
    scale:
      default_color: "#999999"
      bands:
        - { at: 36, color: "#ff0000" }
        - { at: 24, color: "#fc8803" }
        - { at: 12, color: "#11fcf7" }

  - icon: mdi:blur
    entity_id: sensor.example_air_quality_index
    scale:
      default_color: "#999999"
      bands:
        - { at: 300, color: "#ff0000" }
        - { at: 200, color: "#fc8803" }
        - { at: 100, color: "#11fcf7" }

  - icon: mdi:flower-tulip-outline
    entity_id: sensor.example_allergy_index
    scale:
      default_color: "#999999"
      bands:
        - { at: 9.6, color: "#ff0000" }
        - { at: 7.2, color: "#fc8803" }
        - { at: 4.8, color: "#11fcf7" }

  # An indicator whose glyph changes with its entity reads the icon from an attribute.
  - icon_attribute: icon
    icon: mdi:clock-outline
    entity_id: sensor.example_time_of_day
    attribute: remaining

  - icon: mdi:weather-sunset-up
    entity_id: sensor.example_sunrise
    attribute: local_time

  - icon: mdi:weather-sunset-down
    entity_id: sensor.example_sunset
    attribute: local_time

# Read-outs that appear only while something is off its nominal state.
status_indicators:
  - icon: mdi:alert-outline
    entity_id: sensor.example_condition
    nominal_state: Safe
    state_colors:
      Caution: "#11fcf7"
      Unsafe: "#fc8803"
      Dangerous: "#ff0000"
    pulsing_states:
      - Unsafe
      - Dangerous

# Each notice reads its text and icon from its own attributes. Conditional notices render
# only while the entity is `on`; pulsing ones blink to mark something time-sensitive.
notices:
  # A state-driven notice: shown while the entity is off its nominal state, and coloured by
  # whichever state it is in.
  - entity_id: sensor.example_condition
    message_attribute: note
    icon: mdi:alert-outline
    nominal_state: Safe
    state_colors:
      Caution: "#11fcf7"
      Unsafe: "#fc8803"
      Dangerous: "#ff0000"
    pulsing_states:
      - Unsafe
      - Dangerous
  - entity_id: sensor.example_notice_always
    conditional: false
  - entity_id: sensor.example_notice_holiday
  - entity_id: sensor.example_notice_delivery
  - entity_id: sensor.example_notice_collection_day
    pulsing: true
  - entity_id: sensor.example_notice_collection_tomorrow

# A two-sided timeline: one side's calendars down the left, the other's down the right, with
# the time of day in a gutter between them.
agenda:
  empty_text: Nothing today.
  days: 1
  # Titles opening with any of these never reach the panel.
  hidden_prefixes:
    - canceled
    - cancelled
  side_labels:
    left: One
    right: Two
  calendars:
    - entity_id: calendar.example_personal
      name: Personal
      color: primary
      side: right
    - entity_id: calendar.example_shared
      name: Shared
      color: secondary
      side: left
    # `extra` belongs to neither column: its events read as notices instead, under this icon.
    - entity_id: calendar.example_chores
      name: Chores
      color: "#777777"
      side: extra
      icon: mdi:broom
      blocklist: "vacuum|trash|recycling|compost"

# Counts used to size the agenda's scroll animation.
item_count_entities:
  - sensor.example_agenda_count
  - sensor.example_notice_count

toggles:
  - entity_id: group.example_seasonal_lights
    label: Seasonal lights
    icon: mdi:pine-tree
    visible_when: input_boolean.example_seasonal

# Floorplan levels. `image` names an SVG in `resources/floorplans/`; every element
# in it must carry an entity id as its DOM id. Group names drive the CSS classes the browser
# sets, so they must match the stylesheet that ships alongside the SVG.
floorplans:
  downstairs:
    image: downstairs
    groups:
      lights:
        - light.example_kitchen
        - light.example_living_room
      doors:
        - binary_sensor.example_front_door
      windows:
        - binary_sensor.example_living_room_window
      motion:
        - binary_sensor.example_hallway_motion
      sensors:
        - binary_sensor.example_washer
      bins:
        - sensor.example_bin
      fans:
        - switch.example_living_room_fan
      vehicles:
        - binary_sensor.example_driveway_occupied
  upstairs:
    image: upstairs
    groups:
      lights:
        - light.example_bedroom
      doors:
        - binary_sensor.example_bedroom_door
      motion:
        - binary_sensor.example_landing_motion

weather:
  entity_id: weather.example
  sun_entity_id: sun.sun
  # `turning_point_attribute` names a mapping of `temperature`, `hours`, and `upcoming`, shown as
  # "66° ↑ +3h".
  high:
    entity_id: sensor.example_temperature_high
    turning_point_attribute: turning_point
  low:
    entity_id: sensor.example_temperature_low
    turning_point_attribute: turning_point
  summary_entity_id: sensor.example_forecast_summary
  # For the weather face. The zone's latitude and longitude place the sun and moon on the
  # horizon; without one that card stays empty.
  zone_entity_id: zone.home
  forecast_days: 7
  forecast_hours: 12
  # Gusts at or over this, in the weather entity's own unit, show at the tail of the wind's arrow.
  wind_gust_threshold: 15
  # The range bar's colors, blended between these points. In the weather entity's own unit, so
  # an installation in Celsius restates the list rather than having it converted.
  temperature_gradient:
    - { at: 10, color: "#8ab4f8" }
    - { at: 32, color: "#7ecfe0" }
    - { at: 50, color: "#93d3a2" }
    - { at: 70, color: "#fbee84" }
    - { at: 85, color: "#f7b267" }
    - { at: 100, color: "#f2645a" }

camera:
  entity_id: camera.example_street
  title: Traffic

# Where cameras with `stream_type: go2rtc` get live video. Only needed if one does. The panel
# connects to it directly, so it has to be reachable from the tablets and allow their origin.
go2rtc:
  url: http://go2rtc.example:1984

fuel:
  unit: "%"
  scale:
    default_color: "#e1e1e1"
    bands:
      - { at: 33, color: primary }
      - { at: 15, color: secondary }
  gauges:
    - entity_id: sensor.example_vehicle_one_fuel_level
      name: Vehicle One
    - entity_id: sensor.example_vehicle_two_fuel_level
      name: Vehicle Two

transcript:
  entity_id: input_text.example_transcript

# Full-screen overlay shown while the profile's media player is playing matching content.
# Match on a path segment rather than a hostname: players hold onto addresses across a rename,
# so a host that is right today is wrong for whatever is still queued tomorrow.
visualizer:
  content_marker: chime_tts
